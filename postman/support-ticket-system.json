{
  "info":{"name":"Support Ticket Management System","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:5000/api"},{"key":"customerToken","value":""},{"key":"agentToken","value":""},{"key":"ticketId","value":"1"}],
  "item":[
    {"name":"Auth","item":[
      {"name":"Register Customer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Postman Customer\",\n  \"email\": \"postman@example.com\",\n  \"password\": \"password123\"\n}"},"url":"{{baseUrl}}/auth/register"}},
      {"name":"Login Customer","event":[{"listen":"test","script":{"exec":["if (pm.response.code === 200) pm.collectionVariables.set('customerToken', pm.response.json().token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\"\n}"},"url":"{{baseUrl}}/auth/login"}},
      {"name":"Invalid Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"customer@example.com\",\n  \"password\": \"wrong-password\"\n}"},"url":"{{baseUrl}}/auth/login"}},
      {"name":"Login Agent","event":[{"listen":"test","script":{"exec":["if (pm.response.code === 200) pm.collectionVariables.set('agentToken', pm.response.json().token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"agent@example.com\",\n  \"password\": \"password123\"\n}"},"url":"{{baseUrl}}/auth/login"}}
    ]},
    {"name":"Customer Tickets","item":[
      {"name":"Create Ticket","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{customerToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"subject\": \"Login issue\",\n  \"description\": \"I cannot sign in to my account.\",\n  \"priority\": \"High\"\n}"},"url":"{{baseUrl}}/tickets"}},
      {"name":"Get My Tickets","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{customerToken}}"}],"url":"{{baseUrl}}/tickets"}},
      {"name":"Get Ticket By ID","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{customerToken}}"}],"url":"{{baseUrl}}/tickets/{{ticketId}}"}},
      {"name":"Add Comment","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{customerToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"comment\": \"Any update on this issue?\"\n}"},"url":"{{baseUrl}}/tickets/{{ticketId}}/comments"}},
      {"name":"Get Comments","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{customerToken}}"}],"url":"{{baseUrl}}/tickets/{{ticketId}}/comments"}}
    ]},
    {"name":"Agent","item":[
      {"name":"Get All Tickets","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{agentToken}}"}],"url":"{{baseUrl}}/tickets"}},
      {"name":"Update Ticket Status","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{agentToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"status\": \"In Progress\"\n}"},"url":"{{baseUrl}}/tickets/{{ticketId}}"}},
      {"name":"Update Priority and Assignment","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{agentToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"priority\": \"Critical\",\n  \"assigned_to\": 2\n}"},"url":"{{baseUrl}}/tickets/{{ticketId}}"}},
      {"name":"Get Users/Agents","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{agentToken}}"}],"url":"{{baseUrl}}/users"}}
    ]},
    {"name":"Security & Validation","item":[
      {"name":"Unauthorized Request","request":{"method":"GET","url":"{{baseUrl}}/tickets"}},
      {"name":"Customer Forbidden From Users","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{customerToken}}"}],"url":"{{baseUrl}}/users"}},
      {"name":"Invalid Ticket Input","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{customerToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"subject\": \"\",\n  \"description\": \"\",\n  \"priority\": \"Invalid\"\n}"},"url":"{{baseUrl}}/tickets"}},
      {"name":"Ticket Not Found","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{customerToken}}"}],"url":"{{baseUrl}}/tickets/999999"}}
    ]}
  ]
